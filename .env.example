# ====================================================================
# Job Application & Tracking Agent - Environment Configuration
# ====================================================================

# Google Gemini API Key (Get free tier key from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Models Configuration (Gemini Free Tier)
TAILOR_MODEL=gemini-2.5-flash
FAST_MODEL=gemini-2.5-flash

# Google Sheets Spreadsheet ID
# Found in your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional: Telegram Real-time Notifications (Interview alerts, tasks, rejections)
# 1. Message @BotFather on Telegram to create a bot and get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot to get your numeric TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====================================================================
# Cold Email & Recruiter Outreach Configuration
# ====================================================================
# Google App Password for authenticated SMTP delivery in cloud environments:
# (Generate at: https://myaccount.google.com/apppasswords)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Maximum cold emails to dispatch per day (to protect sender domain reputation)
MAX_DAILY_COLD_EMAILS=15

# Optional: Hunter.io API Key for automated verified HR/Recruiter email discovery
# Free tier offers 25 searches/month (https://hunter.io/)
HUNTER_API_KEY=

# ====================================================================
# Cloud Deployment & Scheduler Configuration
# ====================================================================
PORT=8000
HOST=0.0.0.0
# Polling interval in seconds for background Gmail status sweeps (900s = 15m)
EMAIL_POLL_INTERVAL=900

# Optional: Path to custom Chrome User Data Directory (local runs only)
# CHROME_USER_DATA_DIR=C:\Users\<Username>\AppData\Local\Google\Chrome\User Data
